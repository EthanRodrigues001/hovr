{
  "name": "hovr",
  "version": "1.0.3",
  "description": "hovr: a notch at the top of your screen showing the usage limits of your AI coding tools.",
  "author": "Ethan Rodrigues",
  "license": "Apache-2.0",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:github": "npm run build && electron-builder --win nsis -c.extraMetadata.buildTarget=github",
    "build:win": "npm run build:github",
    "package": "npm run build:github",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "build:installer": "node scripts/build-installer.cjs"
  },
  "build": {
    "appId": "com.hovr.app",
    "productName": "HOVR",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json",
      "!resources/installer/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "HOVR",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "HOVR-Update-${version}.${ext}",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "resources/toast.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "EthanRodrigues001",
        "repo": "hovr"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.22",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.4.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@iconify-json/cuida": "^1.2.5",
    "@iconify/react": "^6.0.4",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "electron-updater": "^6.8.11",
    "gsap": "^3.15.0",
    "koffi": "^3.3.6",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.10.1",
    "sql.js": "^1.15.2",
    "svg-path-bbox": "^2.1.0",
    "zustand": "^5.0.16"
  },
  "homepage": "https://github.com/EthanRodrigues001/hovr",
  "repository": {
    "type": "git",
    "url": "https://github.com/EthanRodrigues001/hovr.git"
  }
}
